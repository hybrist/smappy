{
  "name": "@smappy/web-sv",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "DATABASE_URL=${DATABASE_URL:-local.db} vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:eslint": "eslint .",
    "lint": "prettier --check . && eslint .",
    "test": "vitest --run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "DATABASE_URL=${DATABASE_URL:-local.db} tsx scripts/seed-db.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@babel/parser": "^7.28.5",
    "@babel/traverse": "^7.28.5",
    "@babel/types": "^7.28.5",
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.1",
    "@inlang/paraglide-js": "^2.4.0",
    "@jridgewell/source-map": "^0.3.11",
    "@playwright/test": "^1.56.1",
    "@storybook/addon-svelte-csf": "^5.0.10",
    "@storybook/sveltekit": "^10.0.4",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/kit": "^2.48.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.1.16",
    "@types/babel__traverse": "^7.28.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.0",
    "@types/pako": "^2.0.4",
    "@types/rollup": "^0.54.0",
    "@types/webpack": "^5.28.5",
    "@vitest/browser": "^3.2.4",
    "drizzle-kit": "^0.31.6",
    "drizzle-orm": "^0.44.7",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.0.4",
    "eslint-plugin-svelte": "^3.13.0",
    "globals": "^16.5.0",
    "mdsvex": "^0.12.6",
    "pako": "^2.1.0",
    "playwright": "^1.56.1",
    "prettier": "catalog:",
    "prettier-plugin-svelte": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "rollup": "^4.52.5",
    "storybook": "^10.0.4",
    "svelte": "^5.43.3",
    "svelte-check": "^4.3.3",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "catalog:",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.1.12",
    "vite-plugin-devtools-json": "^1.0.0",
    "vitest": "catalog:",
    "vitest-browser-svelte": "^1.1.0",
    "webpack": "^5.102.1"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.42",
    "@ai-sdk/openai": "^2.0.64",
    "@smappy/core": "workspace:*",
    "@smappy/llm-tools": "workspace:*",
    "@smappy/store": "workspace:*",
    "@types/d3": "^7.4.3",
    "ai": "^5.0.89",
    "better-sqlite3": "^12.4.1",
    "d3": "^7.9.0",
    "marked": "^16.4.2",
    "ollama-ai-provider-v2": "^1.5.3",
    "valibot": "^1.1.0"
  }
}
