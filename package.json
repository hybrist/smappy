    "@jridgewell/gen-mapping": "^0.3.8",
    "@jridgewell/source-map": "^0.3.6",
    "@jridgewell/trace-mapping": "^0.3.25",
    "@oxc-parser/binding-wasm32-wasi": "^0.73.2",
