{
  "name": "@smappy/core",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./ast": {
      "types": "./dist/ast/index.d.ts",
      "default": "./src/ast/index.ts"
    },
    "./graph": {
      "types": "./dist/graph/index.d.ts",
      "default": "./src/graph/index.ts"
    },
    "./size": {
      "types": "./dist/size/index.d.ts",
      "default": "./src/size/index.ts"
    },
    "./source-map": {
      "types": "./dist/source-map/index.d.ts",
      "default": "./src/source-map/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json && find dist -name '*.d.ts' -exec sed -i'' -e 's/from \"\\.\\.\\?\\(.*\\)\\.ts\"/from \".\\1.js\"/g' {} \\;",
    "check": "tsdown --no-clean --report false && prettier --check . && tsc",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest --run",
    "prepare": "tsdown && tsc -p tsconfig.build.json && find dist -name '*.d.ts' -exec sed -i'' -e 's/from \"\\.\\.\\?\\(.*\\)\\.ts\"/from \".\\1.js\"/g' {} \\;"
  },
  "dependencies": {
    "@babel/parser": "^7.28.5",
    "@babel/traverse": "^7.28.5",
    "@babel/types": "^7.28.5",
    "@jridgewell/source-map": "^0.3.11",
    "pako": "^2.1.0"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^22.19.0",
    "@types/pako": "^2.0.4",
    "prettier": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./ast": "./dist/ast/index.mjs",
      "./graph": "./dist/graph/index.mjs",
      "./size": "./dist/size/index.mjs",
      "./source-map": "./dist/source-map/index.mjs",
      "./package.json": "./package.json"
    }
  }
}
