{
  "name": "@smappy/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ast": {
      "types": "./dist/ast/index.d.ts",
      "default": "./dist/ast/index.js"
    },
    "./graph": {
      "types": "./dist/graph/index.d.ts",
      "default": "./dist/graph/index.js"
    },
    "./size": {
      "types": "./dist/size/index.d.ts",
      "default": "./dist/size/index.js"
    },
    "./source-map": {
      "types": "./dist/source-map/index.d.ts",
      "default": "./dist/source-map/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "vitest",
    "prepare": "tsc"
  },
  "dependencies": {
    "@babel/parser": "^7.28.5",
    "@babel/traverse": "^7.28.5",
    "@babel/types": "^7.28.5",
    "@jridgewell/source-map": "^0.3.11",
    "pako": "^2.1.0"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^22.19.0",
    "@types/pako": "^2.0.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
