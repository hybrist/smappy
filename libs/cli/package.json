{
  "name": "@smappy/cli",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "check": "tsdown --no-clean --report false && prettier --check . && tsc --noEmit --skipLibCheck",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest --run",
    "prepare": "tsdown"
  },
  "dependencies": {
    "@smappy/core": "workspace:*",
    "@smappy/store": "workspace:*",
    "commander": "^14.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/webpack": "^5.28.5",
    "prettier": "catalog:",
    "rollup": "^4.52.5",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "^7.1.12",
    "vitest": "catalog:",
    "webpack": "^5.102.1"
  },
  "exports": {
    "./main": "./dist/main.mjs",
    "./plugins/angular": "./dist/plugins/angular/index.mjs",
    "./plugins/nextjs": "./dist/plugins/nextjs/index.mjs",
    "./plugins/vite": "./dist/plugins/vite/index.mjs",
    "./plugins/webpack": "./dist/plugins/webpack/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "smappy": "./dist/main.mjs"
  },
  "publishConfig": {
    "bin": {
      "smappy": "./dist/main.mjs"
    },
    "exports": {
      "./main": "./dist/main.mjs",
      "./plugins/angular": "./dist/plugins/angular/index.mjs",
      "./plugins/nextjs": "./dist/plugins/nextjs/index.mjs",
      "./plugins/vite": "./dist/plugins/vite/index.mjs",
      "./plugins/webpack": "./dist/plugins/webpack/index.mjs",
      "./package.json": "./package.json"
    }
  }
}
